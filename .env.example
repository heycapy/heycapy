# copy to .env and uncomment the optional lines you need instead of leaving them blank

# required, heycapy won't start without them
# JWT_SECRET: openssl rand -base64 32
# ENCRYPTION_KEY: openssl rand -hex 32 (keep it, a new one can't read keys saved with the old one)
JWT_SECRET=change-me-to-a-random-32-char-secret
ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# in production point this at persistent storage
DATABASE_URL=file:heycapy.db

# used for telegram webhooks and the links in email and ntfy reminders
APP_URL=https://app.yourdomain.com

# sign in codes and email reminders use resend or smtp when smtp host is set
# with neither the codes show on the login screen which is only for local development
RESEND_API_KEY=re_...
EMAIL_FROM=HeyCapy <noreply@yourdomain.com>
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=HeyCapy <noreply@yourdomain.com>

# use a separate bot for local development
# TELEGRAM_BOT_TOKEN=

# these emails see the system tab and get alerts
ADMIN_EMAILS=you@yourdomain.com
# FEEDBACK_EMAIL=you@yourdomain.com
# SESSION_DURATION_DAYS=30

# the server ai for users without their own key
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# only for selling capy to others where users without their own key pay in credits
# chat and voice then use the models in src/lib/ai/tiers.ts instead of the three ai lines above
# also refuses ollama, and ntfy or smtp servers on a private network, so leave it off for a local ntfy
# HOSTED=true
# one key per provider the tiers use and the server won't start without them
# GEMINI_API_KEY=
